# 复制为 .env 后在本地填写；不要提交真实 .env、密码或密钥。
# 当前应用不会自动加载 .env，需要将所需变量注入进程环境。
# 当前只接入下方 TOWER_* 配置；其余为后续外部服务适配预留，填写后不会自动启用。

# 本地开发
TOWER_MODE=local
TOWER_DATA_DIR=.runtime
# 必填：自行生成至少 24 字符的随机开发口令。
TOWER_DEV_TOKEN=

# 大模型：DeepSeek / OpenAI 兼容 API
API_KEY=
# DeepSeek 示例：https://api.deepseek.com
# OpenAI 示例：https://api.openai.com/v1
BASE_URL=
# 按服务商实际支持的模型填写，例如 deepseek-chat。
LLM_MODEL=

# Milvus：地址不包含协议或端口；启用 TLS 时设置 MILVUS_SECURE=true。
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_SECURE=false
MILVUS_DATABASE=default
MILVUS_COLLECTION=tower_kb_chunks

# BGE-M3：local 表示本地模型，online 表示在线向量服务。
# 预留适配器选择项，当前本地哈希向量检索不会读取这些变量。
BGE_M3_MODE=local
# 本地模型目录，例如 /models/bge-m3；在线模式下可留空。
BGE_M3_MODEL_PATH=
# 本地运行设备：cpu 或 cuda；当前尚未安装模型推理依赖。
BGE_M3_DEVICE=cpu
# 在线模式：填写服务地址、服务实际使用的模型名及可选 API Key。
# 不同服务的协议可能不同，需要接入对应适配器。
BGE_M3_BASE_URL=
BGE_M3_MODEL=
BGE_M3_API_KEY=

# Langfuse（可选）：默认关闭，预留链路观测配置；当前尚未接入 SDK。
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 填写自建实例或所在区域的 Langfuse 地址。
LANGFUSE_BASE_URL=
